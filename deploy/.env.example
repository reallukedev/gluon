# Copy to deploy/.env (ignored by git) and fill in your server. Used by deploy.sh, sync.sh and
# publish-umbrel.sh.
GLUON_HOST=you@192.168.1.10
# deploy.sh: the folder on the server holding Gluon's compose.yaml.
GLUON_DEPLOY_DIR=/home/you/gluon-deploy
# deploy.sh: the GitHub repository the updater downloads from.
# GLUON_REPO=reallukedev/gluon
# publish-umbrel.sh: your Umbrel community app store's id, Caddy config folder and time zone.
UMBREL_STORE=mystore
UMBREL_CADDY_DIR=/home/you/proxy/caddy
TZ=UTC
