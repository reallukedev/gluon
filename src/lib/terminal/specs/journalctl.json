{"name":["journalctl"],"description":"Show the systemd journal","options":[{"name":["-u","--unit"],"description":"Show messages from this unit","args":[{"name":"unit"}]},{"name":["-f","--follow"],"description":"Keep showing new messages as they arrive"},{"name":["-n","--lines"],"description":"How many recent lines to show","args":[{"name":"lines","suggestions":[{"name":"50"},{"name":"200"},{"name":"1000"}]}]},{"name":["-e","--pager-end"],"description":"Jump to the end"},{"name":["-r","--reverse"],"description":"Newest first"},{"name":["-b","--boot"],"description":"Only this boot (or -b -1 for the one before)"},{"name":["-k","--dmesg"],"description":"Kernel messages only"},{"name":["-p","--priority"],"description":"Only this priority or worse","args":[{"name":"priority","suggestions":[{"name":"emerg"},{"name":"alert"},{"name":"crit"},{"name":"err"},{"name":"warning"},{"name":"notice"},{"name":"info"},{"name":"debug"}]}]},{"name":["-S","--since"],"description":"Start at this time","args":[{"name":"time","suggestions":[{"name":"today"},{"name":"yesterday"},{"name":"-1h"},{"name":"-10min"}]}]},{"name":["-U","--until"],"description":"Stop at this time","args":[{"name":"time"}]},{"name":["-o","--output"],"description":"Output format","args":[{"name":"format","suggestions":[{"name":"short"},{"name":"short-iso"},{"name":"verbose"},{"name":"json"},{"name":"json-pretty"},{"name":"cat"}]}]},{"name":["-x","--catalog"],"description":"Add explanations to messages"},{"name":["-g","--grep"],"description":"Only messages matching this pattern","args":[{"name":"pattern"}]},{"name":["--no-pager"],"description":"Print everything instead of paging"},{"name":["--disk-usage"],"description":"How much space the journal uses"},{"name":["--vacuum-size"],"description":"Shrink the journal to this size","args":[{"name":"size","suggestions":[{"name":"500M"},{"name":"1G"}]}]},{"name":["--vacuum-time"],"description":"Delete entries older than this","args":[{"name":"time","suggestions":[{"name":"2weeks"},{"name":"1month"}]}]},{"name":["--list-boots"],"description":"List the boots in the journal"}]}
