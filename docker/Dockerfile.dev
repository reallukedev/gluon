FROM node:24-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      util-linux smartmontools iproute2 procps unzip 7zip xz-utils bzip2 zstd dnsutils iputils-ping \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 GLUON_DATA=/data
CMD ["sh", "-c", "npm install --no-audit --no-fund --foreground-scripts && npx next dev -p ${PORT:-8131} -H 0.0.0.0"]
